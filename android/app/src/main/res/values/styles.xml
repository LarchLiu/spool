<resources>
    <style name="SpoolBaseTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#B74E2D</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#FFFFFF</item>
    </style>
    <style name="SpoolTheme" parent="SpoolBaseTheme" />
    <style name="SpoolDarkTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:colorAccent">#CA7657</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#242423</item>
        <item name="android:navigationBarColor">#242423</item>
        <item name="android:windowBackground">#242423</item>
    </style>
</resources>
