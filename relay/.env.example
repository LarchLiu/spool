# Copy this file to .env and restrict it with chmod 600 .env.
# Generate the administrative credential once with: openssl rand -hex 32
# Keep it across restarts. It is not a Spool server registration token.
SPOOL_RELAY_ADMIN_TOKEN=

# Set false to let Spool register without a pre-issued server token.
# Read at runtime by the relay; an explicit command-line flag takes precedence.
# The administrative credential above is required in both modes.
RELAY_REQUIRE_REGISTRATION_TOKEN=true

# HTTP backend for an HTTPS reverse proxy on this machine.
RELAY_BIND_ADDRESS=127.0.0.1
RELAY_PORT=8788

# Administration always binds to host loopback. Avoid Spool's default 8787 port.
RELAY_ADMIN_PORT=18787
