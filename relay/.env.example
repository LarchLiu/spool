# =============================================================================
# 中文说明
# 下方为完整中文说明；实际配置值统一放在文件末尾，请在那里修改。
# =============================================================================
# Docker Compose 部署模板，从 relay/ 目录执行：
#   cp .env.example .env
#   chmod 600 .env
#   docker compose up -d --build
# 修改后执行 docker compose up -d，更新受影响的容器。
# docker compose restart 不会加载新的环境变量。
# 直接运行二进制或 systemd 服务请使用 deploy/relay.env.example。

# =============================================================================
# 一、仅 Docker Compose 使用：选择服务、配置宿主机端口
# =============================================================================
# 可选值：
# caddy：启动 Relay 和内置 Caddy，本模板默认选择此项。
# 留空：只启动 Relay，使用外部 Caddy、Nginx、Traefik 或 Coolify。
# 关闭已经运行的内置 Caddy 前，先执行：
#   docker compose --profile caddy stop caddy
# COMPOSE_PROFILES=caddy

# 以下端口均为宿主机端口，可填 1–65535 的整数，同一地址上不能冲突。
# 三个端口固定绑定宿主机 127.0.0.1，不直接暴露到公网。
# 容器内监听端口固定为 28080、28081、28082，不随下面的映射改变。
# Relay HTTP 后端，默认 28080；宿主机上的代理通过此端口连接 Relay。
# RELAY_PORT=28080
# 管理页面和 API，默认 28081；宿主机上的管理入口代理连接此端口。
# RELAY_ADMIN_PORT=28081
# Caddy/Traefik 私有集成接口，默认 28082；不得转发到公网。
# RELAY_PROXY_PORT=28082
# 容器中的代理应加入 Relay 所在 Docker 网络，通过 relay:28080/28081/28082 访问。
# 无需设置 RELAY_BIND_ADDRESS，宿主机端口保持回环绑定。

# =============================================================================
# 二、Relay 服务使用：启动时读取，与使用哪种前置代理无关
# =============================================================================
# 必填：管理员凭据，32–512 个字符，不允许换行。
# 生成命令：openssl rand -hex 32
# 用于登录管理页，不是发给各台 Spool 服务器的注册 token。
# SPOOL_RELAY_ADMIN_TOKEN=

# 可选值：
# true：默认值，服务器必须持有管理员签发的注册 token。
# false：允许服务器凭签名身份自动注册，并获得自己的 token。
# 两种模式都必须设置上面的管理员凭据。
# RELAY_REQUIRE_REGISTRATION_TOKEN=true

# Relay 公网 HTTPS 地址，例如 https://relay.example.com，或带端口的
# https://relay.example.com:8443；不能包含路径、查询、片段或用户名密码。
# 发布 Web 子域名和启动自动检测代理时需要填写。
# 留空：仍可使用原生 Relay 连接，关闭 Web 发布和自动代理检测。
# 此地址应到达 Relay 的 28080 服务端口，不是 28081 管理端口。
# 始终以部署值为准，旧的管理页保存值不会覆盖它；管理页只读展示。
# Web 后缀自动使用 web.<此地址的主机名>，不支持自定义。
# 例如主入口为 relay.example.com，每台服务器使用
# https://<服务器ID>.web.relay.example.com/；提前配置 *.web.relay.example.com 的 DNS 和 HTTPS。
# RELAY_PUBLIC_URL=https://relay.example.com

# =============================================================================
# 三、仅内置 Caddy 使用：COMPOSE_PROFILES 留空时以下配置不参与启动
# =============================================================================
# 启用内置 Caddy 时必填。仅填写主机名，不带协议或路径。
# 必须匹配 RELAY_PUBLIC_URL 的主机名。
# 内置 Caddy 固定使用公网 80/443 端口，转发到 relay:28080。
# RELAY_PUBLIC_HOST=relay.example.com
# 管理页面的独立主机名，转发到 relay:28081，必须与公网服务主机名不同。
# RELAY_ADMIN_HOST=admin.example.com

# 可选值：
# individual：默认值，每个已发布的服务器子域名按需申请证书，无需 DNS API。
#             签发前 Caddy 查询 Relay 的私有接口，确认该域名获准发布。
# wildcard：通过 DNS-01 申请 *.web.<RELAY_PUBLIC_HOST> 通配证书，需要下方 Cloudflare token。
# 此选项只有 Caddy 读取，Relay 本身不选择证书类型。
# CADDY_CERTIFICATE_MODE=individual

# 仅内置 Caddy 的 wildcard 模式必填，individual 模式可留空。
# Cloudflare API token，权限为对应 zone 的 DNS 编辑与 Zone 读取，限定到所需区域。
# 仅传给 Caddy 容器，Relay 不接收、不保存 DNS API 凭据。
# 其他 DNS 服务商需自行提供对应 Caddy 插件镜像和代理配置。
# CLOUDFLARE_API_TOKEN=

# =============================================================================
# 四、Relay 的 Traefik 集成使用：仅外部 Traefik/Coolify 部署需要，Caddy 不使用
# =============================================================================
# 独立只读凭据，32–512 个字符，不允许换行；留空关闭 Traefik 配置发现接口。
# 单独生成：openssl rand -hex 32，不能与 SPOOL_RELAY_ADMIN_TOKEN 相同。
# Traefik 的 HTTP Provider 请求 Relay 私有配置接口时，需发送相同的 Bearer 值。
# RELAY_TRAEFIK_TOKEN=

# 可选值：
# letsencrypt：默认值，引用 Traefik 中同名的证书解析器。
# 其他名称：引用已有的自定义解析器，名称可含字母、数字、'-' 和 '_'。
# none：保留 TLS，使用代理已加载的匹配证书，不触发 ACME 申请；none 是保留值。
# 在适用场景下与 Coolify 的 Relay 资源 Certificate resolver 选择对应。
# 这里只引用解析器，不创建解析器；ACME/DNS 凭据仍在 Traefik 配置。
# RELAY_TRAEFIK_RESOLVER=letsencrypt

# 写入动态路由的 Relay 后端地址，默认 http://relay:28080。
# 可用 http:// 或 https://，允许端口，不带路径、查询、片段或用户名密码。
# 必须能从 Traefik 容器访问；使用稳定的 Docker 服务名或网络别名。
# 代理与 Relay 共用 Docker 网络时可直接使用下面的默认值。
# RELAY_PROXY_UPSTREAM=http://relay:28080

# =============================================================================
# English guide
# The complete English guide follows. Edit the active configuration values at the end.
# =============================================================================
# Docker Compose deployment template. Run these commands from relay/:
#   cp .env.example .env
#   chmod 600 .env
#   docker compose up -d --build
# After editing, run docker compose up -d to update affected containers.
# docker compose restart does not load changed environment variables.
# For a standalone binary or systemd service, use deploy/relay.env.example.

# =============================================================================
# 1. Docker Compose only: select services and configure host ports
# =============================================================================
# Options:
# caddy: start Relay and bundled Caddy; the default in this template.
# Empty: start only Relay with an external Caddy, Nginx, Traefik, or Coolify proxy.
# Before disabling bundled Caddy, stop it if it is already running:
#   docker compose --profile caddy stop caddy
# COMPOSE_PROFILES=caddy

# These are host ports: integers from 1 to 65535, without conflicts on the same address.
# All three bind to host 127.0.0.1 and are not directly exposed to the public network.
# Container ports remain 28080, 28081, and 28082 regardless of these mappings.
# Relay HTTP backend; default 28080. A proxy on the host connects through this port.
# RELAY_PORT=28080
# Management page and API; default 28081. The host's management proxy uses this port.
# RELAY_ADMIN_PORT=28081
# Private Caddy/Traefik integration API; default 28082. Do not expose it publicly.
# RELAY_PROXY_PORT=28082
# Containerized proxies should join Relay's Docker network and use
# relay:28080, relay:28081, or relay:28082 as appropriate.
# No RELAY_BIND_ADDRESS setting is needed; host ports stay bound to loopback.

# =============================================================================
# 2. Relay service: read at startup, regardless of the front proxy
# =============================================================================
# Required administrator credential: 32–512 characters, with no line breaks.
# Generate with: openssl rand -hex 32
# Used to sign in to management; separate from registration tokens issued to Spool servers.
# SPOOL_RELAY_ADMIN_TOKEN=

# Options:
# true: default; servers must present a registration token issued by an administrator.
# false: allow servers to enroll automatically using a signed identity and receive a token.
# The administrator credential above is required in both modes.
# RELAY_REQUIRE_REGISTRATION_TOKEN=true

# Public HTTPS origin, such as https://relay.example.com or
# https://relay.example.com:8443. No path, query, fragment, or user information.
# Required for Web subdomain publishing and automatic proxy detection at startup.
# Empty: native Relay connections remain available; Web publishing and detection are disabled.
# This URL must reach Relay's service port 28080, rather than management port 28081.
# The deployed value always takes precedence over old saved settings; management shows it read-only.
# The Web suffix is always web.<this URL's hostname> and cannot be customized.
# For relay.example.com, each server uses https://<server-id>.web.relay.example.com/.
# Configure DNS and HTTPS for *.web.relay.example.com before deployment.
# RELAY_PUBLIC_URL=https://relay.example.com

# =============================================================================
# 3. Bundled Caddy only: unused when COMPOSE_PROFILES is empty
# =============================================================================
# Required when bundled Caddy is enabled. Hostname only, without a scheme or path.
# Must match the hostname in RELAY_PUBLIC_URL.
# Bundled Caddy uses public ports 80/443 and forwards this host to relay:28080.
# RELAY_PUBLIC_HOST=relay.example.com
# Separate management hostname, forwarded to relay:28081; must differ from the public service host.
# RELAY_ADMIN_HOST=admin.example.com

# Options:
# individual: default; obtain certificates on demand for each published server subdomain,
#             without a DNS API. Before issuance, Caddy asks Relay's private API
#             whether the hostname is authorized for publishing.
# wildcard: obtain a *.web.<RELAY_PUBLIC_HOST> certificate using DNS-01;
#           requires the Cloudflare token below.
# Only Caddy reads this option; Relay itself does not select a certificate type.
# CADDY_CERTIFICATE_MODE=individual

# Required only for bundled Caddy's wildcard mode; may be empty in individual mode.
# Cloudflare API token with Zone DNS Edit and Zone Read permissions, scoped to the required zone.
# Passed only to Caddy; Relay neither receives nor stores DNS API credentials.
# Other DNS providers require a suitable Caddy plugin image and proxy configuration.
# CLOUDFLARE_API_TOKEN=

# =============================================================================
# 4. Relay's Traefik integration: external Traefik/Coolify only; unused by Caddy
# =============================================================================
# Separate read-only credential: 32–512 characters, with no line breaks.
# Empty: disable Traefik configuration discovery.
# Generate separately with openssl rand -hex 32; must differ from SPOOL_RELAY_ADMIN_TOKEN.
# Traefik's HTTP provider must send the same Bearer value to Relay's private configuration API.
# RELAY_TRAEFIK_TOKEN=

# Options:
# letsencrypt: default; reference the Traefik certificate resolver of that name.
# Other names: reference an existing custom resolver; letters, digits, '-' and '_' are allowed.
# none: keep TLS using a matching certificate already loaded by the proxy, without ACME requests.
#       The name none is reserved.
# Where applicable, match the Certificate resolver selection on the Relay resource in Coolify.
# This only references a resolver; configure the resolver and ACME/DNS credentials in Traefik.
# RELAY_TRAEFIK_RESOLVER=letsencrypt

# Relay backend URL written into dynamic routes; default http://relay:28080.
# Accepts http:// or https:// and an optional port; no path, query, fragment, or user information.
# Must be reachable from Traefik's container; use a stable Docker service name or network alias.
# The default below works when Traefik and Relay share a Docker network.
# RELAY_PROXY_UPSTREAM=http://relay:28080

# =============================================================================
# 配置值 / Configuration values
# =============================================================================
# Docker Compose
COMPOSE_PROFILES=caddy
RELAY_PORT=28080
RELAY_ADMIN_PORT=28081
RELAY_PROXY_PORT=28082

# Relay
SPOOL_RELAY_ADMIN_TOKEN=
RELAY_REQUIRE_REGISTRATION_TOKEN=true
RELAY_PUBLIC_URL=https://relay.example.com

# Caddy
RELAY_PUBLIC_HOST=relay.example.com
RELAY_ADMIN_HOST=admin.example.com
CADDY_CERTIFICATE_MODE=individual
CLOUDFLARE_API_TOKEN=

# Traefik
RELAY_TRAEFIK_TOKEN=
RELAY_TRAEFIK_RESOLVER=letsencrypt
RELAY_PROXY_UPSTREAM=http://relay:28080
