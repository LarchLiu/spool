# Generate once with: openssl rand -hex 32
# Save the result after '='; keep the same value when restarting the service.
# This administrative credential is separate from each home server's token.
SPOOL_RELAY_ADMIN_TOKEN=
# Optional: false allows automatic server registration. Defaults to true.
RELAY_REQUIRE_REGISTRATION_TOKEN=true
# Optional initial proxy CIDRs; the HTTPS dashboard can detect its proxy.
# Dashboard settings persist in the data directory and take precedence.
RELAY_TRUSTED_PROXIES=
